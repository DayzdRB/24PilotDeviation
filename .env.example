# Google Apps Script persistence (server-side only)
# The deployed Apps Script URL is configured in lib/apps-script.js.
APPS_SCRIPT_SECRET=

# Discord OAuth (server-side; configure the redirect URI in Discord Developer Portal)
# Required for controller filing, voting, comments, profiles, and moderation.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional explicit override. If omitted, production uses the current host + /api/auth/discord/callback
DISCORD_REDIRECT_URI=https://24-pilot-deviation.vercel.app/api/auth/discord/callback

# Recommended dedicated signing secret for 24PD session/OAuth-state cookies.
# If omitted, the server falls back to APPS_SCRIPT_SECRET, but a separate random value is preferred.
SESSION_SECRET=

# Optional: use fictional aircraft instead of 24Data during development
USE_MOCK_24DATA=false
